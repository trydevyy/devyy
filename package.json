{
  "name": "devyy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "check": "tsc -b && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run && npm run test:extension-host && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "tauri build",
    "test:extension-host": "node --test scripts/test-extension-host.mjs"
  },
