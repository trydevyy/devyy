{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devyy Installer",
  "version": "0.3.0",
  "identifier": "xyz.devyy.installer",
  "build": {
    "runner": "igl",
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Devyy Installer",
        "width": 760,
        "height": 580,
        "minWidth": 700,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Install Devyy. Make room for your next idea.",
    "icon": [
      "../../src-tauri/icons/32x32.png",
      "../../src-tauri/icons/128x128.png",
      "../../src-tauri/icons/128x128@2x.png",
      "../../src-tauri/icons/icon.icns",
      "../../src-tauri/icons/icon.ico"
    ],
    "license": "GPL-3.0-only",
    "publisher": "Devyy",
    "copyright": "Copyright \u00a9 2026 Devyy contributors",
    "homepage": "https://www.devyy.dev"
  }
}
