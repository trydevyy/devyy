{
  "identifier": "default",
  "description": "Main editor window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-confirm",
    "core:window:allow-close",
    "core:window:allow-start-dragging"
  ]
}
